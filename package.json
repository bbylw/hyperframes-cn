{
  "name": "hyperframes-cn",
  "version": "2.0.0",
  "private": true,
  "homepage": "https://hyperframes.ndjp.net",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "lint": "vp lint",
    "fmt": "vp fmt src scripts index.html package.json vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json",
    "fmt:check": "vp fmt --check src scripts index.html package.json vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json",
    "preview": "vp preview",
    "serve": "bun run scripts/serve.ts"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  }
}
